# ==============================================================================
# The AI Edge — SMTP & Newsletter Subscription Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual SMTP credentials.
# IMPORTANT: Never commit .env to version control!

# Port for local server (server.js)
PORT=3000

# ------------------------------------------------------------------------------
# 1. SMTP SERVER CONNECTION DETAILS
# ------------------------------------------------------------------------------
# Common Providers:
#   - Gmail:        SMTP_HOST=smtp.gmail.com | SMTP_PORT=587 | SMTP_SECURE=false (Requires Google 2FA & App Password)
#   - Brevo:        SMTP_HOST=smtp-relay.brevo.com | SMTP_PORT=587 | SMTP_SECURE=false
#   - SendGrid:     SMTP_HOST=smtp.sendgrid.net | SMTP_PORT=587 | SMTP_SECURE=false (User: apikey)
#   - Resend:       SMTP_HOST=smtp.resend.com | SMTP_PORT=465 | SMTP_SECURE=true (User: resend)
#   - Amazon SES:   SMTP_HOST=email-smtp.us-east-1.amazonaws.com | SMTP_PORT=587 | SMTP_SECURE=false
#   - Custom cPanel/Hostinger/Zoho/Outlook

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to 'true' for port 465 (SSL), or 'false' for port 587 / 25 (STARTTLS)
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 2. SMTP AUTHENTICATION
# ------------------------------------------------------------------------------
# Your SMTP username / email address
SMTP_USER=your_email@gmail.com

# Your SMTP password or Generated App Password (e.g. 16-character Google App Password)
SMTP_PASS=your_16_character_app_password

# ------------------------------------------------------------------------------
# 3. SENDER INFORMATION (Appears in recipient inbox)
# ------------------------------------------------------------------------------
SMTP_FROM_NAME="The AI Edge Editorial"
SMTP_FROM_EMAIL="editor@theaiedge.com"

# Optional: Set a reply-to address if different from FROM_EMAIL
SMTP_REPLY_TO="contact@theaiedge.com"

# ------------------------------------------------------------------------------
# 4. TESTING
# ------------------------------------------------------------------------------
# Email address to send test dispatch to when running: npm run test:smtp
TEST_RECIPIENT_EMAIL=your_personal_email@example.com
